# HubSphere Environment Configuration
# PostgreSQL is the ONLY supported database
DATABASE_URL=postgresql://hubsphere:hubsphere_secure_password@localhost:5432/hubsphere

# JWT Secrets (change in production!)
JWT_SECRET=hs_jwt_secret_change_in_production_2024
REFRESH_TOKEN_SECRET=hs_refresh_secret_change_in_production_2024

# App URL
APP_URL=http://localhost:3000

# Optional: AI Providers (configure as needed)
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: Communication Providers (configure as needed)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# WHATSAPP_PROVIDER_URL=
# WHATSAPP_API_TOKEN=

# Optional: Email (configure as needed)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Optional: Storage (configure as needed)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
