# HubSphere Phase 1 - PostgreSQL Configuration
# ================================================

# PostgreSQL Connection (REQUIRED)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://hubsphere:hubsphere_secure_password@localhost:5432/hubsphere

# JWT Secrets (minimum 32 characters each, REQUIRED)
JWT_SECRET=dev-secret-key-for-hubsphere-phase1-minimum-32-chars!
REFRESH_TOKEN_SECRET=dev-refresh-secret-key-hubsphere-phase1-min-32!

# App URL (REQUIRED)
APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
