generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT
// ============================================

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  domain      String?
  logoUrl     String?
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  plan        String   @default("FREE") // FREE, STARTER, PRO, ENTERPRISE
  maxUsers    Int      @default(5)
  settings    Json     @default("{}") // JSON settings
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  subscriptions  Subscription[]
  featureFlags   TenantFeatureFlag[]
  auditLogs      AuditLog[]
  roles          Role[]
  calls          Call[]
  leads          Lead[]
  contacts       Contact[]
  companies      Company[]
  deals          Deal[]
  activities     Activity[]
  tags           Tag[]
  notes          Note[]
  tasks          Task[]
  followUps      FollowUp[]
  callRecordings CallRecording[]
  departments      Department[]
  designations    Designation[]
  employees       Employee[]
  leaveTypes      LeaveType[]
  leaveRequests   LeaveRequest[]
  fieldVisits     FieldVisit[]
  expenses        Expense[]
  payrollRecords  PayrollRecord[]
  attendanceSessions AttendanceSession[]
  employeeDocuments  EmployeeDocument[]
  payrollItems      PayrollItem[]
  bankTransfers     BankTransfer[]
  conversations     Conversation[]
  messages          Message[]
  messageAttachments MessageAttachment[]
  commTemplates     CommunicationTemplate[]
  commProviderConfigs CommunicationProviderConfig[]
  deliveryAttempts  DeliveryAttempt[]
  messageEvents     MessageEvent[]
  notifications     Notification[]
  automationWorkflows AutomationWorkflow[]
  automationExecutions AutomationExecution[]
  automationTriggers    AutomationTrigger[]
  automationConditions  AutomationCondition[]
  automationActions     AutomationAction[]
  automationExecutionLogs AutomationExecutionLog[]

  @@map("tenants")
}

// ============================================
// USER
// ============================================

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String    @map("password_hash")
  name              String?
  avatarUrl         String?   @map("avatar_url")
  emailVerified     Boolean   @default(false) @map("email_verified")
  isSuperAdmin      Boolean   @default(false) @map("is_super_admin")
  status            String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at")
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret   String?   @map("two_factor_secret")
  twoFactorRecoveryCodes Json @default("[]") @map("two_factor_recovery_codes")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  memberships         Membership[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerificationToken[]
  ownedLeads          Lead[]     @relation("LeadOwner")
  ownedContacts       Contact[]  @relation("ContactOwner")
  ownedCompanies      Company[]  @relation("CompanyOwner")
  ownedDeals          Deal[]     @relation("DealOwner")
  ownedTasks          Task[]     @relation("TaskOwner")
  ownedFollowUps      FollowUp[] @relation("FollowUpOwner") // userId on FollowUp
  activities          Activity[] @relation("ActivityUser")
  userNotes           Note[]     @relation("NoteUser")
  stageMoves          StageHistory[] @relation("StageMover")
  managedEmployees    Employee[]    @relation("EmployeeManager")
  leaveApprovals     LeaveRequest[] @relation("LeaveApprover")
  expenseApprovals   Expense[]     @relation("ExpenseApprover")
  fieldVisits        FieldVisit[]  @relation("VisitEmployee")
  createdPayroll     PayrollRecord[] @relation("PayrollCreator")
  deptHeaded        Department[]   @relation("DeptHead")
  employeeProfile   Employee[]     @relation("EmployeeProfile")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  sentMessages          Message[]      @relation("MessageSender")
  receivedNotifications Notification[]  @relation("NotificationRecipient")
  automationExecutions  AutomationExecution[] @relation("ExecutionTriggeredBy")
  createdWorkflows      AutomationWorkflow[] @relation("WorkflowCreator")
  updatedWorkflows      AutomationWorkflow[] @relation("WorkflowUpdater")

  @@map("users")
}

// ============================================
// MEMBERSHIP (User <-> Tenant)
// ============================================

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleCode  String?  @default("VIEWER") @map("role_code")
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  invitedBy String?  @map("invited_by")
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleCode], references: [code])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

// ============================================
// ROLE
// ============================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  tenantId    String?  @map("tenant_id") @db.Uuid // null = platform-level role
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]

  @@unique([code, tenantId])
  @@index([tenantId])
  @@map("roles")
}

// ============================================
// PERMISSION
// ============================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // module.action e.g. users.view
  name        String
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

// ============================================
// ROLE <-> PERMISSION
// ============================================

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleCode     String   @map("role_code")
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleCode, permissionId])
  @@index([roleCode])
  @@map("role_permissions")
}

// ============================================
// SUBSCRIPTION
// ============================================

model Subscription {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  plan              String    @default("FREE")
  status            String    @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE, TRIALING
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

// ============================================
// FEATURE FLAG
// (Platform-level defaults)
// ============================================

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenantOverrides TenantFeatureFlag[]

  @@map("feature_flags")
}

// ============================================
// TENANT FEATURE FLAG OVERRIDE
// ============================================

model TenantFeatureFlag {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  featureFlagId String  @map("feature_flag_id") @db.Uuid
  enabled       Boolean
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
  @@map("tenant_feature_flags")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  action     String   // e.g. user.login, tenant.create
  targetType String?  @map("target_type") // e.g. User, Tenant, Role
  targetId   String?  @map("target_id")
  metadata   Json?    // Safe JSON, NEVER passwords/tokens
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// REFRESH TOKEN
// ============================================

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid // Active tenant context when token was issued
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// PASSWORD RESET TOKEN
// ============================================

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================
// EMAIL VERIFICATION TOKEN
// ============================================

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

// ============================================
// CALL (Future-ready for call recording)
// ============================================

model Call {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  leadId            String?   @map("lead_id")
  contactId         String?   @map("contact_id")
  dealId            String?   @map("deal_id")
  agentId           String?   @map("agent_id")
  direction         String?   // INBOUND, OUTBOUND
  callType          String?   @map("call_type") // WEBRTC, VOIP, PSTN
  callStartTime     DateTime? @map("call_start_time")
  callEndTime       DateTime? @map("call_end_time")
  duration          Int?
  callStatus        String?   @map("call_status") // RINGING, CONNECTED, ENDED, FAILED, MISSED
  recordingStatus   String?   @map("recording_status") // RECORDING, PROCESSING, READY, FAILED, NOT_AVAILABLE
  recordingUrl      String?   @map("recording_url")
  recordingProvider String?   @map("recording_provider")
  recordingSize     Int?      @map("recording_size")
  recordingMeta     Json?     @map("recording_meta")
  failureReason     String?   @map("failure_reason")
  retryCount        Int       @default(0) @map("retry_count")
  lastRetryAt       DateTime? @map("last_retry_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordings CallRecording[]

  @@index([tenantId])
  @@index([agentId])
  @@index([callStatus])
  @@index([createdAt])
  @@map("calls")
}

// ============================================
// PROVIDER CONFIG (Platform-level)
// ============================================

model ProviderConfig {
  id          String    @id @default(uuid()) @db.Uuid
  providerId  String    @unique @map("provider_id")
  name        String
  category    String    // AIProvider, SpeechToTextProvider, TextToSpeechProvider, etc.
  enabled     Boolean   @default(false)
  configured  Boolean   @default(false)
  healthy     Boolean?  // null = not yet checked
  config      Json      @default("{}") // Encrypted provider config (API keys etc.)
  priority    Int       @default(0)
  lastCheckAt DateTime? @map("last_check_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@index([enabled])
  @@map("provider_configs")
}

// ============================================
// AI USAGE TRACKING (Future-ready)
// ============================================

model AiUsageLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id")
  userId      String?  @map("user_id")
  providerId  String?  @map("provider_id")
  model       String?
  agentName   String?  @map("agent_name") // Nova, Vox, etc.
  inputTokens Int?     @map("input_tokens")
  outputTokens Int?    @map("output_tokens")
  promptHash  String?  @map("prompt_hash")
  durationMs  Int?     @map("duration_ms")
  status      String   @default("SUCCESS") // SUCCESS, FAILED, RATE_LIMITED
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@index([providerId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ============================================
// CRM: LEAD
// ============================================

model Lead {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  firstName   String   @map("first_name")
  lastName    String?  @map("last_name")
  email       String?
  mobile      String?
  company     String?
  source      String   @default("OTHER") @map("lead_source")
  status      String   @default("NEW")
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  ownerId     String?  @map("owner_id") @db.Uuid
  value       Float?   @default(0)
  description String?
  archived    Boolean  @default(false)
  convertedToContactId String? @map("converted_to_contact_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant              Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner               User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tags                LeadTag[]
  activities          Activity[] @relation("LeadActivities")
  followUps           FollowUp[] @relation("LeadFollowUps")
  entityNotes         Note[]     @relation("LeadNotes")
  convertedToContact  Contact?   @relation("LeadConversion", fields: [convertedToContactId], references: [id])
  fieldVisits         FieldVisit[] @relation("VisitLead")

  @@unique([convertedToContactId])

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([source])
  @@index([email])
  @@index([mobile])
  @@index([createdAt])
  @@map("leads")
}

// ============================================
// CRM: CONTACT
// ============================================

model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  firstName  String   @map("first_name")
  lastName   String?  @map("last_name")
  email      String?
  mobile     String?
  phone      String?
  title      String?
  companyId  String?  @map("company_id") @db.Uuid
  ownerId    String?  @map("owner_id") @db.Uuid
  notes      String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant    Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner     User?         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals     Deal[]
  tags      ContactTag[]
  activities Activity[] @relation("ContactActivities")
  followUps FollowUp[] @relation("ContactFollowUps")
  entityNotes Note[]     @relation("ContactNotes")
  leadSource Lead?       @relation("LeadConversion")
  fieldVisits FieldVisit[] @relation("VisitContact")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([companyId])
  @@index([ownerId])
  @@index([createdAt])
  @@map("contacts")
}

// ============================================
// CRM: COMPANY
// ============================================

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  industry  String?
  website   String?
  email     String?
  phone     String?
  address   String?   @db.Text
  city      String?
  state     String?
  country   String?
  ownerId   String?  @map("owner_id") @db.Uuid
  notes     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner     User?      @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts  Contact[]
  deals     Deal[]
  activities Activity[] @relation("CompanyActivities")
  tags      CompanyTag[]
  entityNotes Note[] @relation("CompanyNotes")

  @@index([tenantId])
  @@index([ownerId])
  @@index([createdAt])
  @@map("companies")
}

// ============================================
// CRM: DEAL (Sales Pipeline)
// ============================================

model Deal {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  title            String
  value            Float     @default(0)
  currency         String    @default("INR")
  stage            String    @default("NEW")
  probability      Int?      @default(0) // 0-100
  expectedCloseDate DateTime? @map("expected_close_date")
  contactId        String?   @map("contact_id") @db.Uuid
  companyId        String?   @map("company_id") @db.Uuid
  ownerId          String?   @map("owner_id") @db.Uuid
  notes            String?
  lostReason       String?   @map("lost_reason")
  archived         Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner     User?      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[] @relation("DealActivities")
  entityNotes Note[] @relation("DealNotes")
  followUps FollowUp[] @relation("DealFollowUps")
  stageHistory StageHistory[]

  @@index([tenantId])
  @@index([stage])
  @@index([ownerId])
  @@index([contactId])
  @@index([companyId])
  @@index([expectedCloseDate])
  @@index([createdAt])
  @@map("deals")
}

// ============================================
// CRM: STAGE HISTORY (Deal pipeline movement)
// ============================================

model StageHistory {
  id        String   @id @default(uuid()) @db.Uuid
  dealId    String   @map("deal_id") @db.Uuid
  fromStage String?  @map("from_stage")
  toStage   String   @map("to_stage")
  movedBy   String?  @map("moved_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  deal  Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user  User? @relation("StageMover", fields: [movedBy], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([createdAt])
  @@map("stage_history")
}

// ============================================
// CRM: TAG
// ============================================

model Tag {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  name     String
  color    String?  @default("#6366f1")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads    LeadTag[]
  contacts ContactTag[]
  companies CompanyTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model LeadTag {
  leadId   String @map("lead_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags")
}

model ContactTag {
  contactId String @map("contact_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model CompanyTag {
  companyId String @map("company_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
  @@map("company_tags")
}

// ============================================
// CRM: ACTIVITY (Timeline events)
// Uses separate nullable FKs per entity type (Prisma-compatible)
// ============================================

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  type        String   // CALL, EMAIL, MEETING, NOTE, TASK, DEAL_STAGE, LEAD_STATUS, etc.
  title       String
  description String?   @db.Text
  userId      String?  @map("user_id") @db.Uuid
  leadId      String?  @map("lead_id") @db.Uuid
  contactId   String?  @map("contact_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  dealId      String?  @map("deal_id") @db.Uuid
  metadata    Json?    // Additional structured data
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation("ActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation("LeadActivities", fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation("ContactActivities", fields: [contactId], references: [id], onDelete: Cascade)
  company Company? @relation("CompanyActivities", fields: [companyId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation("DealActivities", fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([createdAt])
  @@map("activities")
}

// ============================================
// CRM: NOTE
// ============================================

model Note {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  content    String   @db.Text
  userId     String   @map("user_id") @db.Uuid
  leadId     String?  @map("lead_id") @db.Uuid
  contactId  String?  @map("contact_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  dealId     String?  @map("deal_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation("NoteUser", fields: [userId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation("LeadNotes", fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation("ContactNotes", fields: [contactId], references: [id], onDelete: Cascade)
  company Company? @relation("CompanyNotes", fields: [companyId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation("DealNotes", fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([createdAt])
  @@map("notes")
}

// ============================================
// CRM: TASK
// ============================================

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String
  description String?   @db.Text
  status      String    @default("TODO") // TODO, IN_PROGRESS, COMPLETED, CANCELLED
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime? @map("due_date")
  entityType  String?   @map("entity_type") // LEAD, CONTACT, COMPANY, DEAL
  entityId    String?   @map("entity_id") @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User?  @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
  @@index([entityType, entityId])
  @@map("tasks")
}

// ============================================
// CRM: FOLLOW-UP
// ============================================

model FollowUp {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String
  description String?   @db.Text
  status      String    @default("PENDING") // PENDING, COMPLETED, MISSED, CANCELLED
  followUpAt  DateTime  @map("follow_up_at")
  userId      String    @map("user_id") @db.Uuid
  leadId      String?   @map("lead_id") @db.Uuid
  contactId   String?   @map("contact_id") @db.Uuid
  dealId      String?   @map("deal_id") @db.Uuid
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner   User?    @relation("FollowUpOwner", fields: [userId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation("LeadFollowUps", fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation("ContactFollowUps", fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation("DealFollowUps", fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([followUpAt])
  @@index([leadId])
  @@index([contactId])
  @@index([dealId])
  @@map("follow_ups")
}

// ============================================
// CRM: CALL RECORDING
// ============================================

model CallRecording {
  id              String    @id @default(uuid()) @db.Uuid
  callId          String    @map("call_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  status          String    @default("NOT_AVAILABLE") // RECORDING, PROCESSING, READY, FAILED, NOT_AVAILABLE
  recordingUrl    String?   @map("recording_url")
  recordingSize   Int?      @map("recording_size")
  durationSeconds Int?      @map("duration_seconds")
  provider        String?   @map("provider")
  providerMeta    Json?     @map("provider_meta")
  transcript      String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([tenantId])
  @@index([status])
  @@map("call_recordings")
}

// ============================================
// HRMS: DEPARTMENT
// ============================================

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String?  @unique
  description String?  @db.Text
  headId      String?  @map("head_id") @db.Uuid
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  head     User?     @relation("DeptHead", fields: [headId], references: [id], onDelete: SetNull)
  employees Employee[]
  designations Designation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([headId])
  @@map("departments")
}

// ============================================
// HRMS: DESIGNATION
// ============================================

model Designation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String
  description String?  @db.Text
  departmentId String? @map("department_id") @db.Uuid
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees  Employee[]

  @@unique([tenantId, title])
  @@index([tenantId])
  @@index([departmentId])
  @@map("designations")
}

// ============================================
// HRMS: EMPLOYEE
// ============================================

model Employee {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  employeeId      String    @unique @map("employee_code") // e.g. EMP-001
  firstName       String    @map("first_name")
  lastName        String?   @map("last_name")
  email           String?
  mobile          String?
  departmentId    String?   @map("department_id") @db.Uuid
  designationId   String?   @map("designation_id") @db.Uuid
  managerId       String?   @map("manager_id") @db.Uuid
  joiningDate     DateTime? @map("joining_date")
  employmentStatus String   @default("ACTIVE") @map("employment_status") // ACTIVE, INACTIVE, ON_LEAVE, RESIGNED, TERMINATED
  workLocation    String?   @map("work_location")
  basicSalary     Float?    @map("basic_salary")
  salaryCurrency  String    @default("INR") @map("salary_currency")
  emergencyName   String?   @map("emergency_name")
  emergencyPhone  String?   @map("emergency_phone")
  emergencyRelation String?  @map("emergency_relation")
  archived        Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User        @relation("EmployeeProfile", fields: [userId], references: [id], onDelete: Restrict)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager     User?       @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  leaveRequests     LeaveRequest[]
  expenses          Expense[]
  payrollRecords    PayrollRecord[]
  attendanceSessions AttendanceSession[]
  documents         EmployeeDocument[]
  bankTransfers     BankTransfer[]

  @@index([tenantId])
  @@index([userId])
  @@index([departmentId])
  @@index([designationId])
  @@index([managerId])
  @@index([employmentStatus])
  @@index([employeeId])
  @@map("employees")
}

// ============================================
// HRMS: EMPLOYEE DOCUMENT
// ============================================

model EmployeeDocument {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  name        String
  type        String   // RESUME, ID_PROOF, ADDRESS_PROOF, OFFER_LETTER, CONTRACT, OTHER
  fileUrl     String?  @map("file_url")
  fileSize    Int?     @map("file_size")
  status      String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@map("employee_documents")
}

// ============================================
// HRMS: LEAVE TYPE
// ============================================

model LeaveType {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  code            String   // CASUAL, SICK, EARNED, MATERNITY, PATERNITY, etc.
  description     String?  @db.Text
  defaultDays     Int      @map("default_days") @default(0)
  paid            Boolean  @default(true)
  carryForward    Boolean  @default(false) @map("carry_forward")
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRequests   LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("leave_types")
}

// ============================================
// HRMS: LEAVE REQUEST
// ============================================

model LeaveRequest {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  leaveTypeId   String    @map("leave_type_id") @db.Uuid
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  totalDays     Float     @map("total_days")
  reason        String?   @db.Text
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedBy    String?   @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at")
  rejectionReason String?  @db.Text @map("rejection_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  LeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approver   User?      @relation("LeaveApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate])
  @@map("leave_requests")
}

// ============================================
// HRMS: ATTENDANCE SESSION
// ============================================

model AttendanceSession {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  date            DateTime  @map("date") // The work date
  checkInTime     DateTime? @map("check_in_time")
  checkOutTime    DateTime? @map("check_out_time")
  status          String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LATE, ON_LEAVE, HOLIDAY, WEEK_OFF
  workingMinutes  Int?      @map("working_minutes")
  breakMinutes    Int?      @map("break_minutes")
  overtimeMinutes Int?      @map("overtime_minutes")
  lateMinutes     Int?      @map("late_minutes")
  earlyExitMinutes Int?     @map("early_exit_minutes")
  checkInLocation  Json?    @map("check_in_location") // {lat, lng, accuracy, provider}
  checkOutLocation Json?    @map("check_out_location")
  checkInDevice   String?   @map("check_in_device")
  checkOutDevice  String?   @map("check_out_device")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendance_sessions")
}

// ============================================
// FIELD SALES: VISIT
// ============================================

model FieldVisit {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  leadId          String?   @map("lead_id") @db.Uuid
  contactId       String?   @map("contact_id") @db.Uuid
  date            DateTime  @map("date")
  startTime       DateTime? @map("start_time")
  endTime         DateTime? @map("end_time")
  purpose         String?   @db.Text
  outcome         String?   @db.Text
  notes           String?   @db.Text
  status          String    @default("PLANNED") // PLANNED, STARTED, COMPLETED, MISSED, CANCELLED
  location        Json?     // {lat, lng, accuracy, address, provider}
  nextFollowUp    DateTime? @map("next_follow_up")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee User     @relation("VisitEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  lead    Lead?    @relation("VisitLead", fields: [leadId], references: [id], onDelete: SetNull)
  contact Contact? @relation("VisitContact", fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("field_visits")
}

// ============================================
// EXPENSE
// ============================================

model Expense {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  amount        Float
  date          DateTime
  category      String    // TRAVEL, FOOD, ACCOMMODATION, TRANSPORT, COMMUNICATION, EQUIPMENT, OTHER
  description   String?   @db.Text
  receiptUrl    String?   @map("receipt_url")
  receiptSize   Int?      @map("receipt_size")
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  approvedBy    String?   @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at")
  rejectionReason String?  @db.Text @map("rejection_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver User?    @relation("ExpenseApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([category])
  @@index([date])
  @@map("expenses")
}

// ============================================
// PAYROLL RECORD
// ============================================

model PayrollRecord {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  periodStart     DateTime  @map("period_start")
  periodEnd       DateTime  @map("period_end")
  basicSalary     Float     @map("basic_salary")
  totalAllowances Float     @default(0) @map("total_allowances")
  totalDeductions Float     @default(0) @map("total_deductions")
  overtimePay     Float     @default(0) @map("overtime_pay")
  bonus           Float     @default(0)
  netSalary       Float     @map("net_salary")
  currency        String    @default("INR")
  status          String    @default("DRAFT") // DRAFT, PROCESSING, FINALIZED, PAID, CANCELLED
  paymentMethod   String?   @map("payment_method") // BANK_TRANSFER, CASH, CHEQUE
  paymentRef      String?   @map("payment_ref")
  paidAt          DateTime? @map("paid_at")
  notes           String?   @db.Text
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  creator   User?     @relation("PayrollCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items     PayrollItem[]
  bankTransfers BankTransfer[]

  @@unique([employeeId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([periodStart])
  @@map("payroll_records")
}

// ============================================
// PAYROLL ITEM (line items for allowances/deductions)
// ============================================

model PayrollItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  payrollId       String   @map("payroll_id") @db.Uuid
  type            String   // ALLOWANCE, DEDUCTION
  name            String   // e.g. HRA, DA, PF, ESI, TAX
  amount          Float
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payroll PayrollRecord @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([payrollId])
  @@map("payroll_items")
}

// ============================================
// BANK TRANSFER
// ============================================

model BankTransfer {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  payrollId         String    @map("payroll_id") @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  amount            Float
  bankName          String?   @map("bank_name")
  accountNumber     String?   @map("account_number")
  ifscCode          String?   @map("ifsc_code")
  accountHolder     String?   @map("account_holder")
  status            String    @default("PENDING") // PENDING, PROCESSING, SUCCESS, FAILED
  provider          String?   // Provider abstraction for future integration
  transactionRef    String?   @map("transaction_ref")
  providerMeta      Json?     @map("provider_meta")
  initiatedAt       DateTime  @map("initiated_at")
  completedAt       DateTime? @map("completed_at")
  failureReason     String?   @db.Text @map("failure_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payroll PayrollRecord @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([payrollId])
  @@index([employeeId])
  @@index([status])
  @@map("bank_transfers")
}

// ============================================
// COMMUNICATION HUB
// ============================================

// --- PROVIDER CONFIG ---

model CommunicationProviderConfig {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  channel     String   // WHATSAPP, EMAIL, SMS, PUSH
  provider    String   // twilio, sendgrid, ses, fcm, etc.
  config      Json     @default("{}")  // Encrypted provider-specific config
  isEnabled   Boolean  @default(false) @map("is_enabled")
  name        String?  // Human-readable label
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, provider])
  @@index([tenantId])
  @@index([channel])
  @@map("communication_provider_configs")
}

// --- CONVERSATION ---

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  channel       String    // WHATSAPP, EMAIL, SMS, IN_APP, PUSH, SYSTEM
  externalId    String?   @map("external_id") // WhatsApp conversation ID, email thread ID, etc.
  subject       String?   @db.Text
  participantIds Json     @default("[]") @map("participant_ids") // Array of external contact identifiers
  assignedToId  String?   @map("assigned_to_id") @db.Uuid
  status        String    @default("ACTIVE") // ACTIVE, CLOSED, ARCHIVED
  lastMessageAt DateTime? @map("last_message_at")
  lastMessagePreview String? @db.Text @map("last_message_preview")
  unreadCount   Int       @default(0) @map("unread_count")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo  User?     @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([tenantId])
  @@index([channel])
  @@index([assignedToId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("conversations")
}

// --- MESSAGE ---

model Message {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  conversationId  String    @map("conversation_id") @db.Uuid
  direction       String    // INBOUND, OUTBOUND, SYSTEM
  channel         String    // WHATSAPP, EMAIL, SMS, IN_APP, PUSH, SYSTEM
  status          String    @default("QUEUED") // QUEUED, PROCESSING, SENT, DELIVERED, READ, FAILED, CANCELLED
  content         String    @db.Text
  contentType     String    @default("TEXT") @map("content_type") // TEXT, HTML, MARKDOWN, RICH_TEXT
  senderId        String?   @map("sender_id") @db.Uuid // User who sent (null for inbound/system)
  externalMessageId String?  @map("external_message_id")
  externalSenderId  String?  @map("external_sender_id") // WhatsApp number, email address, etc.
  senderName     String?   @map("sender_name")
  isInternal     Boolean   @default(false) @map("is_internal") // Internal note visible only to team
  templateId     String?   @map("template_id") @db.Uuid
  scheduledAt    DateTime? @map("scheduled_at")
  sentAt         DateTime? @map("sent_at")
  deliveredAt    DateTime? @map("delivered_at")
  readAt         DateTime? @map("read_at")
  failedAt       DateTime? @map("failed_at")
  failureReason  String?   @db.Text @map("failure_reason")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?                @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  template     CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]
  deliveryAttempts DeliveryAttempt[]
  events       MessageEvent[]

  @@index([tenantId])
  @@index([conversationId])
  @@index([channel])
  @@index([direction])
  @@index([status])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

// --- MESSAGE ATTACHMENT ---

model MessageAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  fileName    String   @map("file_name")
  fileSize    Int?     @map("file_size")
  mimeType    String   @map("mime_type")
  fileUrl     String?  @map("file_url")
  storageKey  String?  @map("storage_key")
  thumbnailUrl String? @map("thumbnail_url")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([messageId])
  @@map("message_attachments")
}

// --- COMMUNICATION TEMPLATE ---

model CommunicationTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  channel     String   // WHATSAPP, EMAIL, SMS, IN_APP, PUSH
  subject     String?  @db.Text // For email templates
  body        String   @db.Text // Template body with {{variable}} placeholders
  variables   Json     @default("[]") // Array of variable names used in template
  category    String?  // TRANSACTIONAL, MARKETING, NOTIFICATION, ALERT
  status      String   @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([tenantId])
  @@index([channel])
  @@index([status])
  @@map("communication_templates")
}

// --- DELIVERY ATTEMPT ---

model DeliveryAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  messageId   String    @map("message_id") @db.Uuid
  provider    String    // twilio, sendgrid, etc.
  status      String    // PENDING, PROCESSING, SUCCESS, FAILED
  statusCode  String?   @map("status_code")
  response    String?   @db.Text // Provider response body
  cost        Float?    // Delivery cost if tracked
  attemptedAt DateTime  @default(now()) @map("attempted_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([messageId])
  @@index([provider])
  @@map("delivery_attempts")
}

// --- MESSAGE EVENT ---

model MessageEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  eventType   String   @map("event_type") // SENT, DELIVERED, READ, FAILED, REPLIED, CLICKED
  eventData   Json     @default("{}") @map("event_data")
  source      String?  // webhook, polling, manual
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([messageId])
  @@index([eventType])
  @@index([createdAt])
  @@map("message_events")
}

// ============================================
// NOTIFICATION (In-App)
// ============================================

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  recipientId String   @map("recipient_id") @db.Uuid
  title       String
  body        String   @db.Text
  type        String?  // INFO, WARNING, ERROR, SUCCESS, MENTION, ASSIGNMENT
  category    String?  // GENERAL, CRM, HRMS, COMMUNICATION, SYSTEM
  link        String?  // Optional deep link
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient User    @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// AUTOMATION ENGINE
// ============================================

// --- WORKFLOW ---

model AutomationWorkflow {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?  @db.Text
  status      String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, ARCHIVED
  triggerType String   @map("trigger_type") // lead.created, deal.stage_changed, etc.
  triggerConfig Json   @default("{}") @map("trigger_config")
  executionCount Int   @default(0) @map("execution_count")
  lastExecutedAt DateTime? @map("last_executed_at")
  createdBy   String   @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator     User                    @relation("WorkflowCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updater     User?                   @relation("WorkflowUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  triggers    AutomationTrigger[]
  conditions  AutomationCondition[]
  actions     AutomationAction[]
  executions  AutomationExecution[]

  @@index([tenantId])
  @@index([status])
  @@index([triggerType])
  @@map("automation_workflows")
}

// --- TRIGGER ---

model AutomationTrigger {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  eventType   String   @map("event_type") // lead.created, deal.won, task.completed, etc.
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workflowId])
  @@index([eventType])
  @@map("automation_triggers")
}

// --- CONDITION ---

model AutomationCondition {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  workflowId String  @map("workflow_id") @db.Uuid
  field     String   // lead.status, deal.value, etc.
  operator  String   // equals, not_equals, contains, greater_than, less_than, empty, not_empty
  value     String?  @db.Text
  logic     String   @default("AND") // AND, OR
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workflowId])
  @@map("automation_conditions")
}

// --- ACTION ---

model AutomationAction {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  type        String   // create_task, update_lead, send_whatsapp, send_email, etc.
  config      Json     @default("{}")
  sortOrder   Int      @default(0) @map("sort_order")
  delayMs     Int      @default(0) @map("delay_ms") // Delay before executing this action
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workflowId])
  @@map("automation_actions")
}

// --- EXECUTION ---

model AutomationExecution {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  workflowId     String    @map("workflow_id") @db.Uuid
  triggerEvent   String    @map("trigger_event")
  status         String    @default("RUNNING") // RUNNING, COMPLETED, FAILED, CANCELLED
  triggerData    Json      @default("{}") @map("trigger_data")
  entityId       String?   @map("entity_id") // The entity that triggered this (lead ID, deal ID, etc.)
  entityType     String?   @map("entity_type") // lead, deal, task, etc.
  error          String?   @db.Text
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  triggeredById  String?   @map("triggered_by_id") @db.Uuid
  idempotencyKey String    @unique @map("idempotency_key")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow     AutomationWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggeredBy  User?                @relation("ExecutionTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  logs         AutomationExecutionLog[]

  @@index([tenantId])
  @@index([workflowId])
  @@index([status])
  @@index([triggerEvent])
  @@index([entityId])
  @@map("automation_executions")
}

// --- EXECUTION LOG ---

model AutomationExecutionLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  executionId  String   @map("execution_id") @db.Uuid
  actionId     String?  @map("action_id") @db.Uuid
  level        String   @default("INFO") // INFO, WARN, ERROR, DEBUG
  message      String   @db.Text
  data         Json     @default("{}")
  durationMs   Int?     @map("duration_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution AutomationExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([executionId])
  @@index([level])
  @@map("automation_execution_logs")
}
