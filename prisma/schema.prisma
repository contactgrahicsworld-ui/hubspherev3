generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT
// ============================================

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  domain      String?
  logoUrl     String?
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  plan        String   @default("FREE") // FREE, STARTER, PRO, ENTERPRISE
  maxUsers    Int      @default(5)
  settings    Json     @default("{}") // JSON settings
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  subscriptions  Subscription[]
  featureFlags   TenantFeatureFlag[]
  auditLogs      AuditLog[]
  roles          Role[]
  calls          Call[]
  leads          Lead[]
  contacts       Contact[]
  companies      Company[]
  deals          Deal[]
  activities     Activity[]
  tags           Tag[]
  notes          Note[]
  tasks          Task[]
  followUps      FollowUp[]
  callRecordings CallRecording[]

  @@map("tenants")
}

// ============================================
// USER
// ============================================

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String    @map("password_hash")
  name              String?
  avatarUrl         String?   @map("avatar_url")
  emailVerified     Boolean   @default(false) @map("email_verified")
  isSuperAdmin      Boolean   @default(false) @map("is_super_admin")
  status            String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  memberships         Membership[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerificationToken[]
  ownedLeads          Lead[]     @relation("LeadOwner")
  ownedContacts       Contact[]  @relation("ContactOwner")
  ownedCompanies      Company[]  @relation("CompanyOwner")
  ownedDeals          Deal[]     @relation("DealOwner")
  ownedTasks          Task[]     @relation("TaskOwner")
  ownedFollowUps      FollowUp[] @relation("FollowUpOwner") // userId on FollowUp
  activities          Activity[] @relation("ActivityUser")
  userNotes           Note[]     @relation("NoteUser")
  stageMoves          StageHistory[] @relation("StageMover")

  @@map("users")
}

// ============================================
// MEMBERSHIP (User <-> Tenant)
// ============================================

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleCode  String?  @default("VIEWER") @map("role_code")
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  invitedBy String?  @map("invited_by")
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleCode], references: [code])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

// ============================================
// ROLE
// ============================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  tenantId    String?  @map("tenant_id") @db.Uuid // null = platform-level role
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]

  @@unique([code, tenantId])
  @@index([tenantId])
  @@map("roles")
}

// ============================================
// PERMISSION
// ============================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // module.action e.g. users.view
  name        String
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

// ============================================
// ROLE <-> PERMISSION
// ============================================

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleCode     String   @map("role_code")
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleCode, permissionId])
  @@index([roleCode])
  @@map("role_permissions")
}

// ============================================
// SUBSCRIPTION
// ============================================

model Subscription {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  plan              String    @default("FREE")
  status            String    @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE, TRIALING
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

// ============================================
// FEATURE FLAG
// (Platform-level defaults)
// ============================================

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenantOverrides TenantFeatureFlag[]

  @@map("feature_flags")
}

// ============================================
// TENANT FEATURE FLAG OVERRIDE
// ============================================

model TenantFeatureFlag {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  featureFlagId String  @map("feature_flag_id") @db.Uuid
  enabled       Boolean
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
  @@map("tenant_feature_flags")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  action     String   // e.g. user.login, tenant.create
  targetType String?  @map("target_type") // e.g. User, Tenant, Role
  targetId   String?  @map("target_id")
  metadata   Json?    // Safe JSON, NEVER passwords/tokens
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// REFRESH TOKEN
// ============================================

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid // Active tenant context when token was issued
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// PASSWORD RESET TOKEN
// ============================================

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================
// EMAIL VERIFICATION TOKEN
// ============================================

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

// ============================================
// CALL (Future-ready for call recording)
// ============================================

model Call {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  leadId            String?   @map("lead_id")
  contactId         String?   @map("contact_id")
  dealId            String?   @map("deal_id")
  agentId           String?   @map("agent_id")
  direction         String?   // INBOUND, OUTBOUND
  callType          String?   @map("call_type") // WEBRTC, VOIP, PSTN
  callStartTime     DateTime? @map("call_start_time")
  callEndTime       DateTime? @map("call_end_time")
  duration          Int?
  callStatus        String?   @map("call_status") // RINGING, CONNECTED, ENDED, FAILED, MISSED
  recordingStatus   String?   @map("recording_status") // RECORDING, PROCESSING, READY, FAILED, NOT_AVAILABLE
  recordingUrl      String?   @map("recording_url")
  recordingProvider String?   @map("recording_provider")
  recordingSize     Int?      @map("recording_size")
  recordingMeta     Json?     @map("recording_meta")
  failureReason     String?   @map("failure_reason")
  retryCount        Int       @default(0) @map("retry_count")
  lastRetryAt       DateTime? @map("last_retry_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordings CallRecording[]

  @@index([tenantId])
  @@index([agentId])
  @@index([callStatus])
  @@index([createdAt])
  @@map("calls")
}

// ============================================
// PROVIDER CONFIG (Platform-level)
// ============================================

model ProviderConfig {
  id          String    @id @default(uuid()) @db.Uuid
  providerId  String    @unique @map("provider_id")
  name        String
  category    String    // AIProvider, SpeechToTextProvider, TextToSpeechProvider, etc.
  enabled     Boolean   @default(false)
  configured  Boolean   @default(false)
  healthy     Boolean?  // null = not yet checked
  config      Json      @default("{}") // Encrypted provider config (API keys etc.)
  priority    Int       @default(0)
  lastCheckAt DateTime? @map("last_check_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@index([enabled])
  @@map("provider_configs")
}

// ============================================
// AI USAGE TRACKING (Future-ready)
// ============================================

model AiUsageLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id")
  userId      String?  @map("user_id")
  providerId  String?  @map("provider_id")
  model       String?
  agentName   String?  @map("agent_name") // Nova, Vox, etc.
  inputTokens Int?     @map("input_tokens")
  outputTokens Int?    @map("output_tokens")
  promptHash  String?  @map("prompt_hash")
  durationMs  Int?     @map("duration_ms")
  status      String   @default("SUCCESS") // SUCCESS, FAILED, RATE_LIMITED
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@index([providerId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ============================================
// CRM: LEAD
// ============================================

model Lead {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  firstName   String   @map("first_name")
  lastName    String?  @map("last_name")
  email       String?
  mobile      String?
  company     String?
  source      String   @default("OTHER") @map("lead_source")
  status      String   @default("NEW")
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  ownerId     String?  @map("owner_id") @db.Uuid
  value       Float?   @default(0)
  description String?
  archived    Boolean  @default(false)
  convertedToContactId String? @map("converted_to_contact_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant              Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner               User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tags                LeadTag[]
  activities          Activity[] @relation("LeadActivities")
  followUps           FollowUp[] @relation("LeadFollowUps")
  entityNotes         Note[]     @relation("LeadNotes")
  convertedToContact  Contact?   @relation("LeadConversion", fields: [convertedToContactId], references: [id])

  @@unique([convertedToContactId])

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([source])
  @@index([email])
  @@index([mobile])
  @@index([createdAt])
  @@map("leads")
}

// ============================================
// CRM: CONTACT
// ============================================

model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  firstName  String   @map("first_name")
  lastName   String?  @map("last_name")
  email      String?
  mobile     String?
  phone      String?
  title      String?
  companyId  String?  @map("company_id") @db.Uuid
  ownerId    String?  @map("owner_id") @db.Uuid
  notes      String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant    Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner     User?         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals     Deal[]
  tags      ContactTag[]
  activities Activity[] @relation("ContactActivities")
  followUps FollowUp[] @relation("ContactFollowUps")
  entityNotes Note[]     @relation("ContactNotes")
  leadSource Lead?       @relation("LeadConversion")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([companyId])
  @@index([ownerId])
  @@index([createdAt])
  @@map("contacts")
}

// ============================================
// CRM: COMPANY
// ============================================

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  industry  String?
  website   String?
  email     String?
  phone     String?
  address   String?   @db.Text
  city      String?
  state     String?
  country   String?
  ownerId   String?  @map("owner_id") @db.Uuid
  notes     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner     User?      @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts  Contact[]
  deals     Deal[]
  activities Activity[] @relation("CompanyActivities")
  tags      CompanyTag[]
  entityNotes Note[] @relation("CompanyNotes")

  @@index([tenantId])
  @@index([ownerId])
  @@index([createdAt])
  @@map("companies")
}

// ============================================
// CRM: DEAL (Sales Pipeline)
// ============================================

model Deal {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  title            String
  value            Float     @default(0)
  currency         String    @default("INR")
  stage            String    @default("NEW")
  probability      Int?      @default(0) // 0-100
  expectedCloseDate DateTime? @map("expected_close_date")
  contactId        String?   @map("contact_id") @db.Uuid
  companyId        String?   @map("company_id") @db.Uuid
  ownerId          String?   @map("owner_id") @db.Uuid
  notes            String?
  lostReason       String?   @map("lost_reason")
  archived         Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner     User?      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[] @relation("DealActivities")
  entityNotes Note[] @relation("DealNotes")
  followUps FollowUp[] @relation("DealFollowUps")
  stageHistory StageHistory[]

  @@index([tenantId])
  @@index([stage])
  @@index([ownerId])
  @@index([contactId])
  @@index([companyId])
  @@index([expectedCloseDate])
  @@index([createdAt])
  @@map("deals")
}

// ============================================
// CRM: STAGE HISTORY (Deal pipeline movement)
// ============================================

model StageHistory {
  id        String   @id @default(uuid()) @db.Uuid
  dealId    String   @map("deal_id") @db.Uuid
  fromStage String?  @map("from_stage")
  toStage   String   @map("to_stage")
  movedBy   String?  @map("moved_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  deal  Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user  User? @relation("StageMover", fields: [movedBy], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([createdAt])
  @@map("stage_history")
}

// ============================================
// CRM: TAG
// ============================================

model Tag {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  name     String
  color    String?  @default("#6366f1")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads    LeadTag[]
  contacts ContactTag[]
  companies CompanyTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model LeadTag {
  leadId   String @map("lead_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags")
}

model ContactTag {
  contactId String @map("contact_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model CompanyTag {
  companyId String @map("company_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
  @@map("company_tags")
}

// ============================================
// CRM: ACTIVITY (Timeline events)
// Uses separate nullable FKs per entity type (Prisma-compatible)
// ============================================

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  type        String   // CALL, EMAIL, MEETING, NOTE, TASK, DEAL_STAGE, LEAD_STATUS, etc.
  title       String
  description String?   @db.Text
  userId      String?  @map("user_id") @db.Uuid
  leadId      String?  @map("lead_id") @db.Uuid
  contactId   String?  @map("contact_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  dealId      String?  @map("deal_id") @db.Uuid
  metadata    Json?    // Additional structured data
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation("ActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation("LeadActivities", fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation("ContactActivities", fields: [contactId], references: [id], onDelete: Cascade)
  company Company? @relation("CompanyActivities", fields: [companyId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation("DealActivities", fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([createdAt])
  @@map("activities")
}

// ============================================
// CRM: NOTE
// ============================================

model Note {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  content    String   @db.Text
  userId     String   @map("user_id") @db.Uuid
  leadId     String?  @map("lead_id") @db.Uuid
  contactId  String?  @map("contact_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  dealId     String?  @map("deal_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation("NoteUser", fields: [userId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation("LeadNotes", fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation("ContactNotes", fields: [contactId], references: [id], onDelete: Cascade)
  company Company? @relation("CompanyNotes", fields: [companyId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation("DealNotes", fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([createdAt])
  @@map("notes")
}

// ============================================
// CRM: TASK
// ============================================

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String
  description String?   @db.Text
  status      String    @default("TODO") // TODO, IN_PROGRESS, COMPLETED, CANCELLED
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime? @map("due_date")
  entityType  String?   @map("entity_type") // LEAD, CONTACT, COMPANY, DEAL
  entityId    String?   @map("entity_id") @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User?  @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
  @@index([entityType, entityId])
  @@map("tasks")
}

// ============================================
// CRM: FOLLOW-UP
// ============================================

model FollowUp {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String
  description String?   @db.Text
  status      String    @default("PENDING") // PENDING, COMPLETED, MISSED, CANCELLED
  followUpAt  DateTime  @map("follow_up_at")
  userId      String    @map("user_id") @db.Uuid
  leadId      String?   @map("lead_id") @db.Uuid
  contactId   String?   @map("contact_id") @db.Uuid
  dealId      String?   @map("deal_id") @db.Uuid
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner   User?    @relation("FollowUpOwner", fields: [userId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation("LeadFollowUps", fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation("ContactFollowUps", fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation("DealFollowUps", fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([followUpAt])
  @@index([leadId])
  @@index([contactId])
  @@index([dealId])
  @@map("follow_ups")
}

// ============================================
// CRM: CALL RECORDING
// ============================================

model CallRecording {
  id              String    @id @default(uuid()) @db.Uuid
  callId          String    @map("call_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  status          String    @default("NOT_AVAILABLE") // RECORDING, PROCESSING, READY, FAILED, NOT_AVAILABLE
  recordingUrl    String?   @map("recording_url")
  recordingSize   Int?      @map("recording_size")
  durationSeconds Int?      @map("duration_seconds")
  provider        String?   @map("provider")
  providerMeta    Json?     @map("provider_meta")
  transcript      String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([tenantId])
  @@index([status])
  @@map("call_recordings")
}
