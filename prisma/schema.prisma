generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT
// ============================================

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  domain      String?
  logoUrl     String?
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  plan        String   @default("FREE") // FREE, STARTER, PRO, ENTERPRISE
  maxUsers    Int      @default(5)
  settings    Json     @default("{}") // JSON settings
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  subscriptions  Subscription[]
  featureFlags   TenantFeatureFlag[]
  auditLogs      AuditLog[]
  roles          Role[]
  calls          Call[]

  @@map("tenants")
}

// ============================================
// USER
// ============================================

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String    @map("password_hash")
  name              String?
  avatarUrl         String?   @map("avatar_url")
  emailVerified     Boolean   @default(false) @map("email_verified")
  isSuperAdmin      Boolean   @default(false) @map("is_super_admin")
  status            String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  memberships         Membership[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerificationToken[]

  @@map("users")
}

// ============================================
// MEMBERSHIP (User <-> Tenant)
// ============================================

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleCode  String?  @default("VIEWER") @map("role_code")
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  invitedBy String?  @map("invited_by")
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleCode], references: [code])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

// ============================================
// ROLE
// ============================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  tenantId    String?  @map("tenant_id") @db.Uuid // null = platform-level role
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]

  @@unique([code, tenantId])
  @@index([tenantId])
  @@map("roles")
}

// ============================================
// PERMISSION
// ============================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // module.action e.g. users.view
  name        String
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

// ============================================
// ROLE <-> PERMISSION
// ============================================

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleCode     String   @map("role_code")
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleCode, permissionId])
  @@index([roleCode])
  @@map("role_permissions")
}

// ============================================
// SUBSCRIPTION
// ============================================

model Subscription {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  plan              String    @default("FREE")
  status            String    @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE, TRIALING
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

// ============================================
// FEATURE FLAG
// (Platform-level defaults)
// ============================================

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenantOverrides TenantFeatureFlag[]

  @@map("feature_flags")
}

// ============================================
// TENANT FEATURE FLAG OVERRIDE
// ============================================

model TenantFeatureFlag {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  featureFlagId String  @map("feature_flag_id") @db.Uuid
  enabled       Boolean
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
  @@map("tenant_feature_flags")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  action     String   // e.g. user.login, tenant.create
  targetType String?  @map("target_type") // e.g. User, Tenant, Role
  targetId   String?  @map("target_id")
  metadata   Json?    // Safe JSON, NEVER passwords/tokens
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// REFRESH TOKEN
// ============================================

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid // Active tenant context when token was issued
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// PASSWORD RESET TOKEN
// ============================================

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================
// EMAIL VERIFICATION TOKEN
// ============================================

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

// ============================================
// CALL (Future-ready for call recording)
// ============================================

model Call {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  leadId            String?   @map("lead_id")
  contactId         String?   @map("contact_id")
  dealId            String?   @map("deal_id")
  agentId           String?   @map("agent_id")
  direction         String?   // INBOUND, OUTBOUND
  callType          String?   @map("call_type") // WEBRTC, VOIP, PSTN
  callStartTime     DateTime? @map("call_start_time")
  callEndTime       DateTime? @map("call_end_time")
  duration          Int?
  callStatus        String?   @map("call_status") // RINGING, CONNECTED, ENDED, FAILED, MISSED
  recordingStatus   String?   @map("recording_status") // RECORDING, PROCESSING, READY, FAILED, NOT_AVAILABLE
  recordingUrl      String?   @map("recording_url")
  recordingProvider String?   @map("recording_provider")
  recordingSize     Int?      @map("recording_size")
  recordingMeta     Json?     @map("recording_meta")
  failureReason     String?   @map("failure_reason")
  retryCount        Int       @default(0) @map("retry_count")
  lastRetryAt       DateTime? @map("last_retry_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId])
  @@index([callStatus])
  @@index([createdAt])
  @@map("calls")
}

// ============================================
// PROVIDER CONFIG (Platform-level)
// ============================================

model ProviderConfig {
  id          String    @id @default(uuid()) @db.Uuid
  providerId  String    @unique @map("provider_id")
  name        String
  category    String    // AIProvider, SpeechToTextProvider, TextToSpeechProvider, etc.
  enabled     Boolean   @default(false)
  configured  Boolean   @default(false)
  healthy     Boolean?  // null = not yet checked
  config      Json      @default("{}") // Encrypted provider config (API keys etc.)
  priority    Int       @default(0)
  lastCheckAt DateTime? @map("last_check_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@index([enabled])
  @@map("provider_configs")
}

// ============================================
// AI USAGE TRACKING (Future-ready)
// ============================================

model AiUsageLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id")
  userId      String?  @map("user_id")
  providerId  String?  @map("provider_id")
  model       String?
  agentName   String?  @map("agent_name") // Nova, Vox, etc.
  inputTokens Int?     @map("input_tokens")
  outputTokens Int?    @map("output_tokens")
  promptHash  String?  @map("prompt_hash")
  durationMs  Int?     @map("duration_ms")
  status      String   @default("SUCCESS") // SUCCESS, FAILED, RATE_LIMITED
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@index([providerId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}
